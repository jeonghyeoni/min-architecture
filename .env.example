# Supabase — 대시보드 Settings > API 에서 복사
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# ⚠️ service_role 키는 데이터베이스 전체 권한을 가진다.
#    절대 브라우저로 나가면 안 되고, 깃에 커밋해서도 안 된다.
SUPABASE_SERVICE_ROLE_KEY=

# 관리자 로그인 — node scripts/hash-password.mjs '비밀번호' 로 생성
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Vercel > Settings > Git > Deploy Hooks 에서 생성 (main 브랜치)
# 게시 버튼을 누르면 이 주소로 재배포를 요청한다.
VERCEL_DEPLOY_HOOK_URL=

# 아래 둘은 마이그레이션 스크립트 실행에만 필요하다. 이전이 끝나면 지워도 된다.
NOTION_API_KEY=
NOTION_DATABASE_ID=
