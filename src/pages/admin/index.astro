---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getAllForAdmin } from "../../lib/projects";

export const prerender = false;

const projects = await getAllForAdmin();
const drafts = projects.filter((p) => p.status === "draft");
const published = projects.filter((p) => p.status === "published");
---

<AdminLayout title="시공사례">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-xl font-semibold text-foreground">시공사례</h1>
      <p class="text-sm text-muted mt-1">
        전체 {projects.length}개 · 임시저장 {drafts.length}개
      </p>
    </div>
    <a
      href="/admin/new"
      class="px-5 py-2.5 bg-foreground text-background rounded-lg text-sm font-medium hover:opacity-90"
    >
      새 글 쓰기
    </a>
  </div>

  {projects.length === 0 && (
    <p class="text-muted bg-card border border-border rounded-lg px-5 py-10 text-center">
      아직 등록된 시공사례가 없습니다.
    </p>
  )}

  <div class="space-y-2">
    {[...drafts, ...published].map((p) => (
      <div class="bg-card border border-border rounded-lg px-4 py-3 flex items-center gap-4">
        <div class="w-16 h-16 shrink-0 bg-secondary rounded overflow-hidden">
          {p.image && <img src={p.image} alt="" class="w-full h-full object-cover" />}
        </div>
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2 mb-1">
            {p.status === "draft" ? (
              <span class="text-xs px-2 py-0.5 rounded bg-amber-100 text-amber-800">임시저장</span>
            ) : (
              <span class="text-xs px-2 py-0.5 rounded bg-green-100 text-green-800">발행됨</span>
            )}
            <span class="text-xs text-muted">{p.typeKr}</span>
          </div>
          <p class="font-medium text-foreground truncate">{p.title}</p>
          <p class="text-sm text-muted truncate">
            {[p.location, p.year].filter(Boolean).join(" · ")}
          </p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          {p.status === "published" && (
            <a href={`/projects/${p.id}`} target="_blank" rel="noopener"
               class="px-3 py-2 text-sm text-muted hover:text-foreground">보기</a>
          )}
          <a href={`/admin/${p.id}/edit`}
             class="px-3 py-2 text-sm border border-border rounded hover:bg-secondary">수정</a>
          <button data-delete={p.id} data-title={p.title}
                  class="px-3 py-2 text-sm text-red-600 hover:bg-red-50 rounded">삭제</button>
        </div>
      </div>
    ))}
  </div>
</AdminLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-delete]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = btn.dataset.delete;
      if (!confirm(`"${btn.dataset.title}" 글을 삭제할까요?\n되돌릴 수 없습니다.`)) return;

      const res = await fetch(`/api/admin/projects/${id}`, {
        method: "DELETE",
        headers: { "content-type": "application/json" },
      });
      if (!res.ok) {
        alert("삭제에 실패했습니다.");
        return;
      }
      // 발행된 글이었다면 사이트에서도 내려가야 하므로 재배포를 건다.
      await fetch("/api/admin/publish", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: "{}",
      }).catch(() => {});
      location.reload();
    });
  });
</script>
